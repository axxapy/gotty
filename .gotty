# gotty config file. YAML. All keys are optional and shown with their
# defaults; uncomment to override.

# IP address to listen on (default: 0.0.0.0)
# address: "0.0.0.0"

# Port to listen on (default: "8080")
# port: "8080"

# Permit clients to write to the TTY. BE CAREFUL.
# permit_write: false

# Basic-Auth credential in "user:pass" form. Empty means disabled.
# credential: ""

# Append a random string to the URL path to make it unguessable.
# enable_random_url: false
# random_url_length: 8

# TLS/SSL
# enable_tls: false
# tls_crt_file: "~/.gotty.crt"
# tls_key_file: "~/.gotty.key"
# enable_tls_client_auth: false
# tls_ca_crt_file: "~/.gotty.ca.crt"

# Custom index.html file
# index_file: ""

# Title format of the browser window. Variables: command, hostname,
# remote_addr, pid, time.
# title_format: "{{ .command }}@{{ .hostname }}"

# Reconnect on lost connection
# enable_reconnect: false
# reconnect_time: 10

# Max concurrent connections (0 = unlimited)
# max_connection: 0

# Accept only one client and exit on disconnect
# once: false

# Seconds to wait for a client before exiting (0 = disable)
# timeout: 0

# Permit clients to send command-line arguments via URL
# (e.g. http://example.com:8080/?arg=AAA&arg=BBB)
# permit_arguments: true

# Static terminal size (0 = dynamic)
# width: 0
# height: 0

# Regexp matching origin URLs accepted by the WebSocket upgrader.
# Empty means same-origin only.
# ws_origin: ""

# Export cookies / headers from the upgrade request into the child
# process environment as GOTTY_COOKIE_<NAME> / GOTTY_HEADER_<NAME>.
# enable_cookies_export: false
# enable_headers_export: false

# Signal sent to the child process when gotty closes it (default: SIGHUP = 1).
# close_signal: 1

# Seconds to wait before force-killing the child after the client disconnects
# (-1 = wait indefinitely).
# close_timeout: -1
